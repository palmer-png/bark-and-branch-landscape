{
  "rewrites": [
    { "source": "/brokerestimatebuilder", "destination": "/brokerestimatebuilder.html" },
    { "source": "/broker-login", "destination": "/broker-login.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "redirects": [
    { "source": "/brokerestimatebuilder/", "destination": "/brokerestimatebuilder", "permanent": true },
    { "source": "/planting-quotes.html", "destination": "/brokerestimatebuilder", "permanent": true },
    { "source": "/bark-and-branch.html", "destination": "/", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(brokerestimatebuilder.*|planting-quotes.*|broker-login.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ]
}
